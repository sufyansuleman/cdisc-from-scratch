.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto build cache and artifacts (docs/ is COMMITTED — never ignore it)
/_freeze/
/.quarto/
/_book/

# Quarto render artifacts
rendered.log
*.log
**/*.quarto_ipynb
sessions/*_files/
exercises/*_files/

# RStudio project file IS committed: the setup session tells learners to
# open it, and it fixes the working directory to the project root, which
# every code chunk in the course depends on. Only per-user IDE state
# (.Rproj.user, ignored above) is local.

# renv: renv.lock, renv/activate.R and renv/settings.json ARE committed
# (a fresh clone needs them to bootstrap). Only the local library and
# renv's working directories are ignored. Snapshot type is "implicit":
# renv derives dependencies by scanning the project's code.
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/

# OS artifacts
.DS_Store
Thumbs.db

# Local reference material — Implementation Guides, FDA guidance, CDISC
# specification packages. NEVER committed: SDTMIG/ADaMIG/OCCDS and the
# Define-XML package are copyright CDISC and licensed to the reader, not
# redistributable. Cited by section in the sessions, never quoted at length.
# Controlled Terminology is checked programmatically via sdtm.terminology
# instead of from the PDF.
/refs/

# Belt and braces: no PDF or spreadsheet anywhere in the tree, wherever a
# reference document lands by accident.
*.pdf
*.xlsx
*.xls
